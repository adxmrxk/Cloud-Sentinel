    {
      "id": 14,
      "type": "timeseries",
      "title": "Error rates by cloud provider",
      "description": "Failed audit ingestions per provider, and the share of reporter requests answered with 5xx.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 31,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (provider) (rate(cloudsentinel_ingest_errors_total[5m]))",
          "legendFormat": "ingest errors {{provider}}",
          "refId": "A",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum(rate(cloudsentinel_api_requests_total{status=~\"5..\"}[5m])) or vector(0)) / clamp_min(sum(rate(cloudsentinel_api_requests_total[5m])), 1e-9)",
          "legendFormat": "API 5xx ratio",
          "refId": "B",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 15,
            "showPoints": "never",
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
