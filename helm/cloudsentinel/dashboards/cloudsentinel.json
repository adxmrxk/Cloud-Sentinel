      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(cloudsentinel_cache_operations_total{operation=\"get\",result=\"hit\"}[5m])) / clamp_min(sum(rate(cloudsentinel_cache_operations_total{operation=\"get\"}[5m])), 1e-9)",
          "legendFormat": "dashboard cache hit ratio",
          "refId": "A",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (result) (increase(cloudsentinel_notifications_total[1h]))",
          "legendFormat": "slack {{result}} /h",
          "refId": "B",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (result) (increase(cloudsentinel_findings_store_writes_total[1h]))",
          "legendFormat": "postgres writes {{result}} /h",
          "refId": "C",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 15,
            "showPoints": "never",
