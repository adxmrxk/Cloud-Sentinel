{
  "Comment": "CloudSentinel Audit Workflow - Orchestrates security scanning pipeline",
  "StartAt": "RunAuditor",
  "States": {
    "RunAuditor": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${AuditorFunctionArn}",
        "Payload.$": "$"
      },
      "ResultPath": "$.auditResult",
      "ResultSelector": {
        "vulnerabilitiesFound.$": "$.Payload.vulnerabilitiesFound",
        "atRiskBuckets.$": "$.Payload.atRiskBuckets",
        "totalBucketsScanned.$": "$.Payload.totalBucketsScanned",
        "auditTimestamp.$": "$.Payload.auditTimestamp",
        "scanDurationSeconds.$": "$.Payload.scanDurationSeconds",
        "cloudProvider.$": "$.Payload.cloudProvider"
      },
      "Next": "ProcessFindings",
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "AuditFailed",
          "ResultPath": "$.error"
        }
      ]
    },
    "ProcessFindings": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${ReporterFunctionArn}",
        "Payload": {
          "resource": "/ingest",
          "path": "/ingest",
          "httpMethod": "POST",
          "headers": {
            "Content-Type": "application/json",
            "Host": "stepfunctions.internal",
            "Idempotency-Key.$": "$$.Execution.Name"
          },
          "multiValueHeaders": {
            "Content-Type": [
              "application/json"
            ]
          },
          "queryStringParameters": null,
          "multiValueQueryStringParameters": null,
          "pathParameters": null,
          "stageVariables": null,
          "requestContext": {
            "resourcePath": "/ingest",
            "httpMethod": "POST",
            "path": "/Prod/ingest",
            "stage": "Prod",
            "protocol": "HTTP/1.1",
            "requestId.$": "$$.Execution.Name",
            "identity": {
              "sourceIp": "0.0.0.0",
              "userAgent": "AWSStepFunctions"
            }
          },
          "body.$": "States.JsonToString($.auditResult)",
          "isBase64Encoded": false
        }
      },
      "ResultPath": "$.reporterResult",
      "Next": "CheckVulnerabilities",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException",
            "States.Timeout"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 4,
          "BackoffRate": 2,
          "JitterStrategy": "FULL",
          "Comment": "Safe to retry: the execution name is sent as the Idempotency-Key, so a redelivered audit is stored once."
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "ReportingFailed",
          "ResultPath": "$.error"
        }
      ],
      "Comment": "Every audit is recorded, clean ones included, so the dashboard and metrics show that a scan ran. Previously only audits with findings reached the reporter."
    },
    "CheckVulnerabilities": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.auditResult.vulnerabilitiesFound",
          "BooleanEquals": true,
          "Next": "SendAlert"
        }
      ],
      "Default": "AuditComplete",
      "Comment": "Alert only when something was found."
    },
    "SendAlert": {
      "Type": "Task",
      "Resource": "arn:aws:states:::sns:publish",
      "Parameters": {
        "TopicArn": "${SecurityAlertsTopicArn}",
        "Subject": "CloudSentinel Alert: Security Vulnerabilities Detected",
        "Message.$": "States.Format('ALERT: {} S3 bucket(s) with public access misconfiguration detected. Buckets at risk: {}', States.ArrayLength($.auditResult.atRiskBuckets), States.JsonToString($.auditResult.atRiskBuckets))"
      },
      "Next": "AuditComplete"
    },
    "AuditComplete": {
      "Type": "Succeed",
      "Comment": "Audit completed successfully"
    },
    "AuditFailed": {
      "Type": "Fail",
      "Error": "AuditError",
      "Cause": "The Auditor function encountered an error"
    },
    "ReportingFailed": {
      "Type": "Fail",
      "Error": "ReportingError",
      "Cause": "The Reporter function encountered an error"
    }
  }
}
